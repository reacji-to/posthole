{
  "manifest_version": 3,
  "name": "posthole",
  "version": "0.3.0",
  "description": "Saves every post you scroll past on X, LinkedIn, Bluesky, Threads and Hacker News to a local folder.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.linkedin.com/*",
    "https://bsky.app/*",
    "https://*.threads.com/*",
    "https://*.threads.net/*",
    "https://news.ycombinator.com/*",
    "https://*.twimg.com/*",
    "https://*.bsky.app/*",
    "https://*.bsky.network/*",
    "https://plc.directory/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.licdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.linkedin.com/*",
        "https://bsky.app/*",
        "https://*.threads.com/*",
        "https://*.threads.net/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.linkedin.com/*",
        "https://bsky.app/*",
        "https://*.threads.com/*",
        "https://*.threads.net/*",
        "https://news.ycombinator.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "posthole",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
